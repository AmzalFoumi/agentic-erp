# Template for backend/.env
#
# THIS file (.env.example) is committed to git. It documents which settings
# exist, using fake values. The real file - backend/.env - is gitignored and
# never leaves your machine.
#
# To set up: copy this file to .env, then fill in the real password.
#   Windows PowerShell:  Copy-Item .env.example .env

# ---------------------------------------------------------------------------
# DATABASE_URL - how SQLAlchemy reaches Postgres.
# ---------------------------------------------------------------------------
#
# Anatomy of the string:
#
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
#   \________/ \_____/   \__/ \______/ \__/ \__/ \______/
#     dialect   driver   user  secret  host  port   db
#
# Three details that trip people up with Supabase:
#
# 1. It MUST start with `postgresql+psycopg://`. The dashboard gives you
#    `postgres://`. `postgresql` is the dialect SQLAlchemy expects, and
#    `+psycopg` tells it to use psycopg 3 (the driver we pinned) rather than
#    the older psycopg2 it would otherwise reach for.
#
# 2. Use the SESSION POOLER string (host ends in `.pooler.supabase.com`,
#    port 5432), not the "direct connection" one. Supabase's direct endpoint
#    is IPv6-only on the free plan; the session pooler is IPv4 and works from
#    any network. Session mode - unlike transaction mode on port 6543 - also
#    supports prepared statements, which SQLAlchemy uses by default.
#
# 3. Add `?sslmode=require` so the connection is encrypted in transit.
#
# Get the real string from the Supabase dashboard: your project ->
# "Connect" button -> "Session pooler" tab. Then swap the scheme and append
# sslmode as shown below.

DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:YOUR-PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Everything below is optional - these have sensible defaults in config.py.
# ---------------------------------------------------------------------------

# Set to "true" to have SQLAlchemy print every SQL statement it runs. Very
# useful while learning; noisy in normal use.
SQL_ECHO=false

# ---------------------------------------------------------------------------
# CORS_ORIGINS - which browser origins may call this API.
# ---------------------------------------------------------------------------
#
# Only browsers care. curl, the MCP server, and any server-to-server caller are
# unaffected, which is why a request can succeed in your terminal and fail from
# the frontend with no change to the API.
#
# FORMAT TRAP: pydantic-settings parses a `list[str]` field from the
# environment as JSON, not as a comma-separated string. It must be a JSON
# array, with double quotes:
#
#   CORS_ORIGINS=["https://inventory.example.com"]
#
# `CORS_ORIGINS=https://a.com,https://b.com` does not fail cleanly - it fails
# at import with a JSON decode error before the app starts.
#
# Note `localhost` and `127.0.0.1` are DIFFERENT origins to a browser even
# though they are the same machine. Both are in the default, so leaving this
# unset is correct for local development - it is listed here only so the
# variable is discoverable when the time comes to deploy.
#
# Do not set this to ["*"]. It is harmless only while there is no
# authentication; combined with credentials it lets any site a logged-in user
# visits call this API as them.

# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
