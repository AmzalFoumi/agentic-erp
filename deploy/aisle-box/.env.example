# ═══════════════════════════════════════════════════════════════════════════════════════
#  The box's settings file — a template. Real values are NOT in this repository.
#
#  WHAT TO DO WITH IT
#  The submission comes with a file called `aisle.env`. Copy it into this folder and rename
#  it to `.env`. Then fill in the one blank
#  line at the bottom if you have a Google AI key. That is the whole configuration step.
#
#      cp /path/to/aisle.env deploy/aisle-box/.env
#
#
#  Every value is already filled in for you in `aisle.env`. You should not need to
#  understand the list below; it is here so the shape of the file is visible in the repo for AI Agents.
# ═══════════════════════════════════════════════════════════════════════════════════════

# ── The database ───────────────────────────────────────────────────────────────────────
# Where the products and the AI conversations are kept. A hosted Postgres database, shared
# by everyone running this box, reached with a login that can read and write exactly three
# tables and nothing else.
#
# Read by: api, mcp, agent.
DATABASE_URL=postgresql+psycopg://aisle_demo.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ── The login server's own credentials ─────────────────────────────────────────────────
# These belong to THIS box and were generated for it. They are not the developer's.
#
# A "client secret" is the password an application uses to prove it is itself when it talks
# to the login server. A client *ID* alongside it is only a name badge — that one is public
# and is written directly into docker-compose.yml.

# The website's secret. Used by server-side code only; never sent to a browser.
THUNDERID_GATE_CLIENT_SECRET=

# The AI agent's secret. The agent is the only part of the system that asks the login
# server for a token rather than merely checking one.
THUNDERID_AGENT_CLIENT_SECRET=

# Signs the website's own session cookie. Not a login-server value — it is the website's
# private key for "this visitor already signed in". Generated with `openssl rand -base64 32`.
THUNDERID_SECRET=

# ── The only line you fill in yourself ─────────────────────────────────────────────────
# A Google AI Studio key, from https://aistudio.google.com/apikey — free, about a minute.
#
# LEAVE IT BLANK IF YOU DON'T WANT ONE. The box still starts and the entire deterministic inventory
# system works. Only the AI chat panel
# stops working, and it says so rather than hanging.
GEMINI_API_KEY=

# Optional. Which AI model the assistant uses. Leave it out and the box uses `flash-lite`,
# which is what this demo was built against. `gemma-31b` is the alternative - a much higher
# free-tier daily limit, slightly less inclined to use its tools without being asked.
#GEMINI_MODEL=flash-lite

# ── Not settable, on purpose ───────────────────────────────────────────────────────────
# AUTH_ENABLED is fixed to `true` inside docker-compose.yml and is deliberately not read
# from this file. It is a single switch that turns identity checking off across two
# services at once, so it must not be flippable by editing a text file.
