# ---------- Python ----------
# Virtual environment: a private copy of Python + packages for this project.
# Never committed - each developer recreates it from requirements.txt.
.venv/
venv/
env/

# Compiled bytecode Python generates automatically when it imports your files.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Secrets ----------
# Real credentials live here. .env.example (the template, no real values) IS committed.
.env
.env.*
!.env.example

# ---------- ThunderID key material (deploy/) ----------
# Per-deployment TLS/signing material generated by ThunderID's setup.sh and living in the
# thunderid-certs Docker volume. Copies are pulled onto the host with `docker cp` so Node
# can trust the self-signed server (NODE_EXTRA_CA_CERTS) — they belong to THIS machine's
# instance, are regenerated whenever setup.sh reruns, and must never be committed.
# deploy/thunderid-deployment.yaml is NOT ignored: it is configuration, and is tracked.
deploy/*.cert
deploy/*.key
deploy/*.pem

# ---------- Personal helper scripts ----------
# Convenience wrappers for one developer's own machine (e.g. launching Claude Code
# with this machine's ThunderID certificate trusted). They hardcode local paths and
# would not work on anyone else's setup, so they are deliberately untracked.
# Root-anchored so a future package named `scripts/` deeper in the tree is unaffected.
/scripts/

# ---------- Node / Next.js (frontend/) ----------
# Note: the .env.* rule above also covers frontend/.env.local. Any env template must be
# named exactly .env.example to survive the negation — .env.local.example would be ignored.
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
.vercel/

# ---------- Editors / OS ----------
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# ---------- Agent skills (installed via `npx skills`) ----------
# The CLI keeps a canonical copy in .agents/ for the agents it supports; this project only
# uses Claude Code, which reads .claude/skills/. That copy is the one we track.
.agents/

# Workspace files the `teach` skill writes into whatever directory it runs in. Root-anchored
# so they can't shadow real directories elsewhere in the tree (e.g. a frontend assets/).
/MISSION.md
/RESOURCES.md
/NOTES.md
/reference/
/lessons/
/learning-records/
/assets/
