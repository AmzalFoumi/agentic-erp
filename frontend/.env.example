# Committed template. Copy to `.env.local` and fill in — `.env.local` is gitignored.
#
# Both values are deliberately SERVER-SIDE ONLY: no `NEXT_PUBLIC_` prefix, so
# neither is inlined into the browser bundle. Only the `src/lib/api` tree reads
# them, and only from React Server Components or route-free server code.

# The FastAPI adapter (`backend/api/`). The dev default matches
# `uvicorn api.main:app --reload` run from `backend/`.
API_BASE_URL=http://127.0.0.1:8000

# The agent service — a separate project that fronts the MCP server, not the MCP
# server itself. Read as of Gate 20 by `src/app/api/agent/[...path]/route.ts`,
# the one route handler in this tree, which forwards to it.
#
# The dev default matches `python scripts/serve.py` run from `agent/`. 8000 is
# FastAPI, 8001 is its MCP server, 8002 is the agent.
#
# **Loopback, and that is load-bearing.** The agent binds to 127.0.0.1 with no
# authentication, so this value pointing anywhere else — a LAN address, a tunnel,
# a deployed host — expires the auth deferral and triggers the login gate before
# any further agent work. See `agent/app.py`'s HOST comment and docs/PLAN.md.
AGENT_BASE_URL=http://127.0.0.1:8002

# ── ThunderID (Gate 24) ─────────────────────────────────────────────────────
# The identity provider. Runs as a fifth service, started from
# deploy/docker-compose.thunderid.yml. See docs/AUTH-PLAN.md.
#
# Note the split: the two NEXT_PUBLIC_ values below ARE inlined into the browser
# bundle, unlike everything above this line. That is correct and required — the
# browser talks to ThunderID directly — but it means the header comment at the
# top of this file describes the first two variables only, not these.

# Where ThunderID is reachable. Public: the browser calls it directly.
NEXT_PUBLIC_THUNDERID_BASE_URL=https://localhost:8090

# Authenticates our SERVER when it starts the embedded sign-in flow, sent in the
# `Flow-Secret` request header. **Not an OAuth client secret** — the embedded
# flow uses no client secret at all, and the two are separate credentials. The
# installed skill v0.2.0 calls this THUNDERID_CLIENT_SECRET and is wrong; the
# v1.0.0 Console and the docs site both say FLOW_SECRET. See docs/AUTH-PLAN.md.
#
# Shown exactly once at application creation; regenerating it from the
# Credentials tab invalidates the old one. Treat as a password — never prefix
# NEXT_PUBLIC_.
THUNDERID_FLOW_SECRET=

# Console -> the application -> Overview -> Application details -> Application ID.
# **Not the Client ID.** The two are different values and mixing them up makes
# the embedded components render blank — the vendor's own troubleshooting note.
NEXT_PUBLIC_THUNDERID_APPLICATION_ID=

# Where <SignInButton> sends the browser. Setting this is what makes it use our
# own embedded page instead of redirecting to the ThunderID-hosted "Gate".
NEXT_PUBLIC_THUNDERID_SIGN_IN_URL=/signin

# **There is deliberately no NEXT_PUBLIC_THUNDERID_SIGN_UP_URL**, and no
# app/signup page, though the vendor's quickstart has both. Aisle is a
# supermarket's internal system: accounts are created by an administrator in
# the ThunderID Console, never by self-service registration, which would let
# anyone reaching the login page mint an account against live inventory. The
# Sign-up Flow is correspondingly toggled OFF on the application's Flows tab —
# setting this variable without turning that on yields a sign-up link to a flow
# the server refuses to run. Recovery Flow is off for the same reason plus a
# practical one: no mail server. Admins reset passwords in the Console.

# Signs OUR session cookie. Not a ThunderID value and never sent to it — one
# word away from THUNDERID_FLOW_SECRET and unrelated to it. Generate with
# `openssl rand -base64 32` (at least 32 characters).
THUNDERID_SECRET=

# ⚠️ LOCAL ONLY — must not survive to deployment. ThunderID's certificate is
# self-signed, which Node refuses by default. This disables TLS verification
# for the WHOLE Node process, not just calls to ThunderID. Gate 26 owns
# replacing it with a real certificate; the Python half has the same shortcut
# (`verify=`) and the same expiry.
NODE_TLS_REJECT_UNAUTHORIZED=0
